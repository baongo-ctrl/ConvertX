# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional overrides for the Google Apps Script form endpoints.
# If either variable is unset or empty, the site keeps using the endpoint
# already built into the client. These values are public in the built site.
# VITE_CONTACT_SCRIPT_URL=
# VITE_EVENT_SCRIPT_URL=

# HubSpot Forms API v3 (portal 247838082, NA2).
# Form GUIDs are public (they appear in HubSpot embed code). Hardcoded defaults
# live in src/lib/hubspotSubmit.ts and public/js/cx-hubspot.js; set these only
# to override (e.g. a staging form). Empty / REPLACE_ME keeps the default.
# VITE_HS_FORM_CONTACT=98c275d7-4f86-491b-8680-75e745f6dd13
# VITE_HS_FORM_EVENT=75ffdf25-ce73-4a8b-ada0-67c0f20f2b77
# VITE_HS_FORM_RESOURCE=852bb154-4735-4c5a-9df2-6e83a2c8dac7
# VITE_HS_FORM_CHAT=46a3cbed-64d9-4c4e-b2d5-b0dbc7ef9ad8
