{
  "redirects": [
    {
      "source": "/:path((?!convertx-vs-agency/?$|convertx-vs-agency/en/?$).*)/",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/en"
      }
    }
  ],
